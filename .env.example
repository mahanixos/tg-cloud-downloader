# =====================================================================
# tg-cloud-downloader — environment configuration (PLACEHOLDERS ONLY)
# Copy to ".env" and fill in real values. Never commit ".env".
# =====================================================================

# ---- Core ----
NODE_ENV=development
# Logging level: debug | info | warn | error
LOG_LEVEL=info
# Use in-memory mock storage + mock telegram so the app runs without creds.
# Set to "false" (and provide real creds) for live operation.
USE_MOCKS=true

# ---- Telegram (MTProto large-file receiver) ----
# From https://my.telegram.org -> "API development tools"
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional: pre-generated session string. If absent, an interactive phone login
# is required on first run (you enter the code once).
TELEGRAM_SESSION=
# Optional Bot API token (from @BotFather) for /start + returning download links
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to use the bot. Empty = allow all (dev only).
ALLOWED_CHAT_IDS=

# ---- Google Drive (primary storage candidate) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Target folder ID in your Drive where files are uploaded
GOOGLE_DRIVE_FOLDER_ID=

# ---- Cloudflare R2 (download/cache/delivery candidate) ----
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base for R2 objects / Worker URL (delivery layer), e.g.
# https://cdn.example.com  or  https://<worker>.workers.dev
R2_PUBLIC_URL=

# ---- Download / Delivery ----
# Base URL used when generating signed download links, e.g. https://dl.example.com
DOWNLOAD_BASE_URL=http://localhost:8787
# SECRET used to sign download tokens (HMAC). Generate a long random string.
DOWNLOAD_SECRET=change-me-to-a-long-random-secret
# Signed URL lifetime in seconds (default 3600 = 1h)
DOWNLOAD_URL_TTL=3600

# ---- Storage / Delivery strategy ----
# One of: gdrive-only | r2-only | gdrive-primary-r2-cache | gdrive-primary-r2-mirror
STORAGE_STRATEGY=gdrive-primary-r2-cache

# ---- Resource limits ----
# Max concurrent uploads (queue). 1 = sequential.
MAX_CONCURRENCY=1
# Guard: never buffer more than this many bytes of a single file in RAM at once.
# Streaming/chunked transfer must respect this. (default 64 MiB)
MAX_MEMORY_BUFFER=67108864
# Chunk size used when reading/writing streams (bytes). (default 8 MiB)
CHUNK_SIZE=8388608
